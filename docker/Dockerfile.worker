# ============================================================
# Image Worker Celery — inclut Tesseract pour les workers OCR
# Une seule image servie pour tous les workers (ocr / ai / webhook)
# ============================================================
FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Dépendances système :
#  - libpq-dev pour psycopg
#  - tesseract-ocr + langues fra et eng pour l'OCR
#  - poppler-utils pour pdf2image (conversion PDF → image)
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        tesseract-ocr \
        tesseract-ocr-fra \
        tesseract-ocr-eng \
        poppler-utils \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt /app/requirements.txt
RUN pip install --upgrade pip && pip install -r /app/requirements.txt

COPY app /app/app
COPY alembic /app/alembic
COPY alembic.ini /app/alembic.ini

RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

# Par défaut on lance la queue ocr — surchargé par docker-compose
CMD ["celery", "-A", "app.workers.celery_app", "worker", "--loglevel=INFO", "--queues=ocr"]
