# ============================================================
# Image API FastAPI — Python 3.11 slim
# Build optimisé : layer dépendances séparée, user non-root
# ============================================================
FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Dépendances système — psycopg, libpq, et headers SSL
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        ca-certificates \
        curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Layer dépendances (rarement modifiée)
COPY requirements.txt /app/requirements.txt
RUN pip install --upgrade pip && pip install -r /app/requirements.txt

# Code applicatif
COPY app /app/app
COPY alembic /app/alembic
COPY alembic.ini /app/alembic.ini

# Utilisateur non-root. On crée /app/uploads AVANT le chown : ainsi un volume
# nommé monté sur ce chemin hérite du propriétaire appuser (sinon root → EACCES).
RUN mkdir -p /app/uploads \
    && useradd -m -u 1000 appuser \
    && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

# Healthcheck — le load balancer doit pouvoir vérifier l'API
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:8000/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
