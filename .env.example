# ============================================================
# Configuration de l'API SaaS Admission WhatsApp
# Copier ce fichier vers .env et remplir les vraies valeurs
# ============================================================

# Environnement : development | staging | production
ENVIRONMENT=development

# Niveau de log : DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Clé secrète pour signature interne (JWT, sessions admin éventuelles)
# Générer avec : python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=changeme-generer-une-cle-aleatoire-de-64-caracteres-minimum

# ---------------- Base de données PostgreSQL ----------------
# Format : postgresql+psycopg://user:password@host:port/dbname
DATABASE_URL=postgresql+psycopg://admission:admission@postgres:5432/admission_db

# ---------------- Redis (cache + broker Celery) -------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------------- Twilio WhatsApp ---------------------------
# Récupérer depuis https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Numéro WhatsApp Twilio (format : whatsapp:+14155238886)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# ---------------- Fournisseur IA --------------------------------
# "anthropic" ou "gemini" (Gemini Flash — quota gratuit Google AI Studio)
AI_PROVIDER=gemini

# ---------------- Anthropic Claude (optionnel si AI_PROVIDER=anthropic) ----
# Récupérer depuis https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ---------------- Google Gemini Flash (optionnel si AI_PROVIDER=gemini) ----
# Récupérer depuis https://aistudio.google.com/apikey (quota gratuit)
GOOGLE_AI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_AI_MODEL=gemini-2.0-flash

# ---------------- Google Cloud Storage ----------------------
GCS_BUCKET_NAME=admission-documents-prod
GCS_PROJECT_ID=mon-projet-gcp
# Chemin local vers le fichier de credentials JSON du service account
GOOGLE_APPLICATION_CREDENTIALS=/app/credentials/gcs-key.json

# ---------------- Webhooks (sécurité) -----------------------
# Fenêtre de validité (en secondes) du timestamp HMAC pour protection replay
WEBHOOK_TIMESTAMP_TOLERANCE=300

# ---------------- Monitoring / Observabilité ----------------
# Optionnel - laisser vide pour désactiver Sentry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# ---------------- Rate limiting -----------------------------
# Limite par défaut sur les endpoints API (par clé API)
RATE_LIMIT_DEFAULT=100/minute
# Limite sur le webhook Twilio entrant (par numéro de téléphone)
RATE_LIMIT_WHATSAPP=30/minute

# ---------------- CORS --------------------------------------
# Origines autorisées en production, séparées par virgules
CORS_ALLOWED_ORIGINS=https://app.universite-exemple.tg,https://admin.universite-exemple.tg

# ---------------- Swagger (dev — pré-remplissage Authorize) ----
# Renseigner après seed-university ou scripts/create_university.py
SWAGGER_DEMO_API_KEY=
SWAGGER_DEMO_API_SECRET=

# ---------------- OCR Tesseract -----------------------------
# Langues installées pour Tesseract (fra+eng par défaut)
TESSERACT_LANG=fra+eng
# Chemin vers l'exécutable Tesseract (rarement nécessaire sur Docker)
TESSERACT_CMD=
